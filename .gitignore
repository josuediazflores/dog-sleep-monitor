# --- secrets ---
.env

# --- local config (contains your camera's LAN address) ---
config.json

# --- captured imagery: pictures of the inside of a home. never commit. ---
snapshots/
archive/
archive-old-angle/
preview.jpg
*.jpg
*.jpeg
*.png
*.mp4

# --- captured data ---
# Globs, not filenames. These files record when the home is unattended, and
# this repo is public. Listing exact names let `sleep_log.pi.csv` (a copy
# pulled off the Pi) sit untracked-but-not-ignored, one `git add -A` away
# from being published. Match by extension so a renamed copy cannot escape.
*.csv
!config.example.json
watch.out
*.log

# --- runtime state written by the running monitor ---
# Not secret, but it is machine-local state (a pid, the current feed status)
# that would be meaningless to anyone else and would conflict on every pull.
# Ignored by name AND by the temp suffix the atomic writer uses, so a crash
# mid-write cannot leave a stray file staged either.
heartbeat.json
*.tmp

# Scratch for anything pulled off the Pi or backed up locally. Never tracked.
.local/
.backup-*/

# --- python ---
.venv/
__pycache__/
*.pyc
report.html
*.html
markers.csv
dataset/
references/
empty_reference.jpg
