# Copy to .env and fill in. .env is gitignored; chmod 600 it.

# Tapo Camera Account credentials (Tapo app > Device Settings > Advanced Settings > Camera Account)
# These are the *Camera Account*, not your TP-Link login. The camera keeps its
# RTSP server switched off until that account exists.
TAPO_USER=
TAPO_PASS=

# Bearer token for `monitor.py serve`. Required -- the server refuses to start
# without one of at least 24 characters, which is why the API had never been
# run before this line existed.
#
# Generate it ON the machine that will serve, never on another box and scp'd:
#   echo "MONITOR_API_TOKEN=$(openssl rand -hex 32)" >> .env
#
# Command substitution is stored unexpanded in shell history, so that records
# the command and not the secret.
MONITOR_API_TOKEN=
